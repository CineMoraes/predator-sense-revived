<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:PredatorSenseRevived.Controls">

    <Color x:Key="CyanC">#00AEC7</Color>
    <Color x:Key="BlueC">#3B6CFF</Color>
    <SolidColorBrush x:Key="Cyan" Color="#00AEC7"/>
    <SolidColorBrush x:Key="Blue" Color="#3B6CFF"/>
    <SolidColorBrush x:Key="LightBlue" Color="#6FA0FF"/>
    <SolidColorBrush x:Key="Text" Color="#E9EDF5"/>
    <SolidColorBrush x:Key="Soft" Color="#C6CEDC"/>
    <SolidColorBrush x:Key="Sub" Color="#A5AFC2"/>
    <SolidColorBrush x:Key="Muted" Color="#8D97AB"/>
    <SolidColorBrush x:Key="Dim" Color="#6B7589"/>
    <SolidColorBrush x:Key="Line" Color="#2A3550"/>
    <SolidColorBrush x:Key="Amber" Color="#F5A524"/>
    <SolidColorBrush x:Key="Green" Color="#3DDC97"/>
    <SolidColorBrush x:Key="Chip" Color="#BF121826"/>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00AEC7" Offset="0"/>
        <GradientStop Color="#3B6CFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#941C263E" Offset="0"/>
        <GradientStop Color="#850A0E18" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassEdge" Color="#296FA0FF"/>

    <FontFamily x:Key="Display">Bahnschrift</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStyle" Value="Oblique"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Soft}"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Desc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="Badge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Amber}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Glass card: chamfered corners with cyan/blue accent lines -->
    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- soft dark shadow under the card -->
                        <c:Plate Kind="Chamfer" Cut="16" Fill="#99000000" Margin="0,8,0,-8">
                            <c:Plate.Effect><BlurEffect Radius="22"/></c:Plate.Effect>
                        </c:Plate>
                        <c:Plate Kind="Chamfer" Cut="16" Fill="{StaticResource Glass}" Stroke="{StaticResource GlassEdge}" AccentA="{StaticResource Cyan}" AccentB="{StaticResource Blue}">
                            <c:Plate.Effect><DropShadowEffect Color="#3B6CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.22"/></c:Plate.Effect>
                        </c:Plate>
                        <!-- light from the top edge, fading down to a darker bottom -->
                        <c:Plate Kind="Chamfer" Cut="16">
                            <c:Plate.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1C9FC0FF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                                    <GradientStop Color="#00000000" Offset="0.7"/>
                                    <GradientStop Color="#33000000" Offset="1"/>
                                </LinearGradientBrush>
                            </c:Plate.Fill>
                        </c:Plate>
                        <ContentPresenter Margin="22,18"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slanted button -->
    <Style x:Key="SlantButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Sub}"/>
        <Setter Property="Background" Value="{StaticResource Chip}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="20,9"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Background="Transparent">
                        <c:Plate Kind="Slant" Cut="10" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Opacity" Value="0.85"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SlantButton}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Segmented choice (slanted). Checked = gradient. -->
    <Style x:Key="Seg" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Sub}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root" MinHeight="38" Background="Transparent">
                        <c:Plate x:Name="bg" Kind="Slant" Cut="9" Fill="{StaticResource Chip}"/>
                        <ContentPresenter Margin="20,9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Fill" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slanted on/off switch -->
    <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Width="52" Height="24" Background="Transparent">
                        <c:Plate x:Name="track" Kind="Slant" Cut="6" Fill="#222B3E"/>
                        <c:Plate x:Name="knob" Kind="Slant" Cut="4" Fill="#7D879A" Width="18" Height="16" HorizontalAlignment="Left" Margin="6,0,0,0">
                            <c:Plate.RenderTransform><TranslateTransform x:Name="shift" X="0"/></c:Plate.RenderTransform>
                        </c:Plate>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Fill" Value="{StaticResource Accent}"/>
                            <Setter TargetName="knob" Property="Fill" Value="White"/>
                            <Setter TargetName="knob" Property="Margin" Value="28,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left menu item -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Height" Value="70"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root" Background="Transparent">
                        <Rectangle x:Name="glow" Opacity="0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#592B4FB8" Offset="0"/>
                                    <GradientStop Color="#000B0E15" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Path x:Name="mark" Data="M0,0 L6,6 L6,36 L0,42 Z" Fill="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="glow" Property="Opacity" Value="1"/>
                            <Setter TargetName="mark" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource LightBlue}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Soft}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain icon/text button (window controls, footer links) -->
    <Style x:Key="Bare" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Soft}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource Blue}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
    </Style>

    <!-- Thin dark scroll bar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="4" Background="#556FA0FF" Margin="1,2"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F0121826"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
</ResourceDictionary>
